<services>
  <service name="obs_scm">
    <param name="url">https://github.com/Percona-Lab/stormweaver.git</param>
    <param name="scm">git</param>
    <param name="revision">%!{STORMWEAVER_REVISION}</param>
    <param name="submodules">enable</param>
    <param name="version">%!{STORMWEAVER_PACKAGE_VERSION}</param>
    <param name="filename">stormweaver</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version">
    <param name="basename">stormweaver</param>
  </service>
</services>
