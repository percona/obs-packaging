Format: 3.0 (quilt)
Source: percona-postgresql-%!{PG_MAJOR_VERSION}
Binary:
    libpq-dev,
    libpq5,
    libecpg6,
    libecpg-dev,
    libecpg-compat3,
    libpgtypes3,
    percona-postgresql-%!{PG_MAJOR_VERSION},
    percona-postgresql-client-%!{PG_MAJOR_VERSION},
    percona-postgresql-server-dev-%!{PG_MAJOR_VERSION},
    percona-postgresql-doc-%!{PG_MAJOR_VERSION},
    percona-postgresql-plperl-%!{PG_MAJOR_VERSION},
    percona-postgresql-plpython3-%!{PG_MAJOR_VERSION},
    percona-postgresql-pltcl-%!{PG_MAJOR_VERSION}
Architecture: any all
Version: 2:%!{PG_PACKAGE_VERSION}-%!{PKG_REVISION}
Maintainer: Percona Development Team <info@percona.com>
Build-Depends:
    autoconf,
    bison,
    clang [amd64 arm64 mips64el ppc64 ppc64el s390x] <!pkg.postgresql.nollvm>,
    dh-exec (>= 0.13~),
    docbook-xml,
    docbook-xsl (>= 1.77),
    dpkg-dev (>= 1.16.1~),
    flex,
    gdb <!nocheck>,
    gettext,
    krb5-multidev,
    libedit-dev,
    libicu-dev,
    libio-pty-perl <!nocheck>,
    libipc-run-perl <!nocheck>,
    libkrb5-dev,
    libldap2-dev,
    lz4 | liblz4-tool,
    liblz4-dev,
    libpam0g-dev | libpam-dev,
    libperl-dev,
    libreadline-dev,
    libselinux1-dev [linux-any],
    libssl-dev,
    libsystemd-dev [linux-any],
    libxml2-dev,
    libxml2-utils,
    libxslt1-dev,
    llvm-dev [amd64 arm64 mips64el ppc64 ppc64el s390x] <!pkg.postgresql.nollvm>,
    mawk,
    openssl,
    perl (>= 5.8),
    pkg-config,
    python3-dev,
    systemtap-sdt-dev [linux-any],
    tcl-dev,
    uuid-dev,
    xsltproc,
    zlib1g-dev,
    libcurl4,
    libcurl4-openssl-dev,
    curl | libz-dev,
    zstd (>= 1.4.0) <!pkg.postgresql.nozstd>,
    libzstd-dev (>= 1.4.0) <!pkg.postgresql.nozstd>,
    percona-postgresql-common-dev
Debtransform-Release: 1
Debtransform-Files-Tar: debian.tar.gz
