#!/usr/bin/make -f

export LC_ALL=C.UTF-8
export LANG=C.UTF-8
export READTHEDOCS=no

%:
	dh $@ --with=python3 --buildsystem=pybuild

override_dh_builddeb:
	dh_builddeb -- -Zgzip


override_dh_auto_clean:
	-dh_auto_clean
	rm -rf docs/build features/output coverage.xml .coverage*
	rm -rf .cache .eggs dummy junit.xml .pybuild

override_dh_auto_build:
	dh_auto_build
	(cd docs; $(MAKE) html)

# patroni.service is installed via debian/percona-patroni.install and, like the
# repo.percona.com package, is neither enabled nor started: the admin runs
# "systemctl enable --now patroni" once /etc/patroni/patroni.yml exists.
override_dh_systemd_enable override_dh_systemd_start override_dh_installsystemd:

override_dh_installdocs:
	dh_installdocs
	dh_sphinxdoc /usr/share/doc/patroni/html

override_dh_auto_test:
	python3 -m pytest tests

