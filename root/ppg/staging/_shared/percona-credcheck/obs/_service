<services>
  <service name="obs_scm">
    <param name="url">https://github.com/HexaCluster/credcheck.git</param>
    <param name="scm">git</param>
    <param name="revision">%!{CREDCHECK_TAG}</param>
    <param name="version">%!{CREDCHECK_VERSION}</param>
    <param name="filename">percona-credcheck</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version">
    <param name="basename">percona-credcheck</param>
  </service>
</services>
