<services>
  <service name="obs_scm">
    <param name="url">https://github.com/citusdata/pg_cron.git</param>
    <param name="scm">git</param>
    <param name="revision">%!{PG_CRON_REF}</param>
    <param name="version">%!{PG_CRON_VERSION}</param>
    <param name="versionformat">%!{SCM_VERSIONFORMAT}</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="filename">percona-pg_cron_%!{PG_MAJOR_VERSION}</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version">
    <param name="basename">percona-pg_cron_%!{PG_MAJOR_VERSION}</param>
    <param name="file">pg_cron.spec</param>
  </service>
  <service mode="%!{SET_VERSION_DEB_MODE}" name="set_version">
    <param name="basename">percona-pg_cron_%!{PG_MAJOR_VERSION}</param>
  </service>
</services>
