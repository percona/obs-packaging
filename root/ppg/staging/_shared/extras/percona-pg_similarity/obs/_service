<services>
  <service name="obs_scm">
    <param name="url">https://github.com/eulerto/pg_similarity.git/</param>
    <param name="scm">git</param>
    <param name="revision">%!{PG_SIMILARITY_TAG}</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">pg_similarity_(\d+)_(\d+)</param>
    <param name="versionrewrite-replacement">\1.\2</param>
    <param name="filename">percona-pg_similarity_%!{PG_MAJOR_VERSION}</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version">
    <param name="basename">percona-pg_similarity_%!{PG_MAJOR_VERSION}</param>
  </service>
</services>
