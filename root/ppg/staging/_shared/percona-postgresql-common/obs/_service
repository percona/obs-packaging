<services>
  <service name="obs_scm">
    <param name="url">https://salsa.debian.org/postgresql/postgresql-common.git</param>
    <param name="scm">git</param>
    <param name="revision">%!{POSTGRESQL_COMMON_REF}</param>
    <param name="version">%!{POSTGRESQL_COMMON_VERSION}</param>
    <param name="versionformat">%!{SCM_VERSIONFORMAT}</param>
    <param name="versionrewrite-pattern">debian/(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="filename">percona-postgresql-common</param>
  </service>
  <service mode="buildtime" name="tar" />
  <service mode="buildtime" name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service mode="buildtime" name="set_version">
    <param name="file">percona-postgresql-common.spec</param>
  </service>
  <service mode="%!{SET_VERSION_DEB_MODE}" name="set_version" />
</services>
