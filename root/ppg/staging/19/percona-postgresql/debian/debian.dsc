Format: 3.0 (quilt)
Source: percona-postgresql-%!{PG_MAJOR_VERSION}
Binary: libpq-dev,
        libpq5,
        libpq-oauth,
        libecpg6,
        libecpg-dev,
        libecpg-compat3,
        libpgtypes3,
        percona-postgresql-%!{PG_MAJOR_VERSION},
        percona-postgresql-client-%!{PG_MAJOR_VERSION},
        percona-postgresql-server-dev-%!{PG_MAJOR_VERSION},
        percona-postgresql-doc-%!{PG_MAJOR_VERSION},
        percona-postgresql-plperl-%!{PG_MAJOR_VERSION},
        percona-postgresql-plpython3-%!{PG_MAJOR_VERSION},
        percona-postgresql-pltcl-%!{PG_MAJOR_VERSION},
        percona-postgresql-%!{PG_MAJOR_VERSION}-jit
Architecture: any all
Version: 1.0
Maintainer: Percona Development Team <info@percona.com>
Build-Depends: autoconf,
               bison,
               clang [amd64 arm64 mips64el ppc64 ppc64el s390x] | clang-21 [amd64 arm64 mips64el ppc64 ppc64el s390x] <!pkg.postgresql.nollvm>,
               debhelper-compat (= 13),
               dh-exec (>= 0.13~),
               docbook-xml,
               docbook-xsl (>= 1.77),
               dpkg-dev (>= 1.16.1~),
               flex,
               gdb <!nocheck>,
               gettext,
               krb5-multidev,
               libcurl4-openssl-dev [linux-any],
               libedit-dev,
               libicu-dev,
               libio-pty-perl <!nocheck>,
               libipc-run-perl <!nocheck>,
               libkrb5-dev,
               libldap2-dev,
               liblz4-dev,
               libnuma-dev [linux-any],
               libpam0g-dev | libpam-dev,
               libperl-dev <!noperl>,
               libreadline-dev,
               libselinux-dev [linux-any],
               libssl-dev,
               libsystemd-dev [linux-any],
               liburing-dev [linux-any],
               libxml2-dev,
               libxml2-utils,
               libxslt1-dev,
               llvm-dev [amd64 arm64 mips64el ppc64 ppc64el s390x] | llvm-21-dev [amd64 arm64 mips64el ppc64 ppc64el s390x] <!pkg.postgresql.nollvm>,
               lz4 | liblz4-tool,
               mawk,
               openssl,
               perl (>= 5.8),
               percona-postgresql-common-dev,
               pkgconf,
               python3-dev <!nopython>,
               systemtap-sdt-dev,
               tcl-dev <!notcl>,
               tzdata <!nocheck>,
               uuid-dev,
               xsltproc,
               libzstd-dev (>= 1.4.0),
               zlib1g-dev | libz-dev,
               zstd (>= 1.4.0),
Debtransform-Release: 1
Debtransform-Files-Tar: debian.tar.gz
