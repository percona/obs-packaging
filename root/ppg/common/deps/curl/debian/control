Depends: libcurl4t64 (= ${binary:Version}),
         ${misc:Depends},
         ${shlibs:Depends},
Multi-Arch: foreign
Description: command line tool for transferring data with URL syntax
 curl is a command line tool for transferring data with URL syntax, supporting
 DICT, FILE, FTP, FTPS, GOPHER, HTTP, HTTPS, IMAP, IMAPS, LDAP, LDAPS, MQTT,
 POP3, POP3S, RTSP, SCP, SFTP, SMB, SMTP, SMTPS, TELNET and TFTP.
 .
 Percona build of curl 8.23.0 for Percona Distribution for PostgreSQL.

# One binary name on every Debian/Ubuntu release: Debian 13 and Ubuntu
# 24.04+ ship libcurl4t64, Debian 12 and Ubuntu 22.04 ship libcurl4. The
# versioned Provides/Breaks/Replaces take over libcurl4 the same way
# Debian's own time64 transition did, so packages depending on libcurl4
# (>= x) are satisfied and the distro library is replaced.
Package: libcurl4t64
Architecture: any
Section: libs
Multi-Arch: same
Pre-Depends: ${misc:Pre-Depends},
Depends: ${misc:Depends},
         ${shlibs:Depends},
Recommends: ca-certificates,
Provides: libcurl4 (= ${binary:Version}),
Breaks: libcurl4 (<< ${binary:Version}),
Conflicts: libcurl3,
Replaces: libcurl3,
          libcurl4,
Description: easy-to-use client-side URL transfer library (OpenSSL flavour)
 libcurl is an easy-to-use client-side URL transfer library, supporting DICT,
 FILE, FTP, FTPS, GOPHER, HTTP, HTTPS, IMAP, IMAPS, LDAP, LDAPS, MQTT, POP3,
 POP3S, RTSP, SCP, SFTP, SMB, SMTP, SMTPS, TELNET and TFTP.
 .
 Percona build of libcurl 8.23.0 for Percona Distribution for PostgreSQL.
 SSL support is provided by OpenSSL.

