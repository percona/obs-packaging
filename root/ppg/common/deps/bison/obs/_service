<services>
  <service name="download_url">
    <!-- ftpmirror.gnu.org redirects to a nearby GNU mirror; ftp.gnu.org itself
         throttles/refuses cloud IP ranges (GitHub Actions runners included). -->
    <param name="host">ftpmirror.gnu.org</param>
    <param name="protocol">https</param>
    <param name="path">/bison/bison-3.8.2.tar.gz</param>
    <param name="filename">bison-3.8.2.tar.gz</param>
  </service>
</services>
