<services>
  <!-- PERCONA: two upstream tarballs, one per tarball base. The RPM spec
       picks Source0 on RHEL 8 (GDAL GIS_GDAL_EL8_VERSION like gdal38,
       SONAME libgdal.so.34) and Source1 on RHEL 9 (GDAL GIS_GDAL_VERSION
       like gdal313, SONAME libgdal.so.39) so our library is a drop-in for
       the GDAL that PostGIS links on each base. Versions come from
       root/macros.yaml. download.osgeo.org is upstream's own release
       archive. -->
  <service name="download_url">
    <param name="host">download.osgeo.org</param>
    <param name="protocol">https</param>
    <param name="path">/gdal/%!{GIS_GDAL_EL8_VERSION}/gdal-%!{GIS_GDAL_EL8_VERSION}.tar.xz</param>
    <param name="filename">gdal-%!{GIS_GDAL_EL8_VERSION}.tar.xz</param>
  </service>
  <service name="download_url">
    <param name="host">download.osgeo.org</param>
    <param name="protocol">https</param>
    <param name="path">/gdal/%!{GIS_GDAL_VERSION}/gdal-%!{GIS_GDAL_VERSION}.tar.xz</param>
    <param name="filename">gdal-%!{GIS_GDAL_VERSION}.tar.xz</param>
  </service>
</services>
