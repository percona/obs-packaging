<services>
  <!-- PERCONA: two upstream tarballs, one per tarball base. The RPM spec
       picks Source0 on RHEL 8 (PROJ GIS_PROJ_EL8_VERSION, like proj96) and
       Source1 on RHEL 9 (PROJ GIS_PROJ_VERSION, like proj98), both
       libproj.so.25, so our library is a drop-in for the PROJ that PostGIS
       links on each base. Versions come from root/macros.yaml.
       download.osgeo.org is upstream's own release archive; the GitHub
       release assets for these tags redirect to a signed CDN URL that OBS
       cannot pin. -->
  <service name="download_url">
    <param name="host">download.osgeo.org</param>
    <param name="protocol">https</param>
    <param name="path">/proj/proj-%!{GIS_PROJ_EL8_VERSION}.tar.gz</param>
    <param name="filename">proj-%!{GIS_PROJ_EL8_VERSION}.tar.gz</param>
  </service>
  <service name="download_url">
    <param name="host">download.osgeo.org</param>
    <param name="protocol">https</param>
    <param name="path">/proj/proj-%!{GIS_PROJ_VERSION}.tar.gz</param>
    <param name="filename">proj-%!{GIS_PROJ_VERSION}.tar.gz</param>
  </service>
</services>
